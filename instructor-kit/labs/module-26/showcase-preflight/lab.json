{
  "title": "Final project evidence check (a tool, run two days before the showcase)",
  "lesson": "showcase",
  "tasks": 2,
  "runs": [
    {
      "name": "starter-as-downloaded",
      "dir": "starter",
      "cmd": "node ../evidence_check.mjs kit/starter",
      "exit": "nonzero",
      "expect": [
        "NOT READY: fix the FIX lines above, then run this check again"
      ],
      "course": "final-project-kit",
      "into": "kit"
    },
    {
      "name": "solution",
      "dir": "solution",
      "cmd": "cp -r project/. kit/starter/ && node ../evidence_check.mjs kit/starter",
      "exit": 0,
      "expect": [
        "READY FOR THE SHOWCASE"
      ],
      "absent": [
        "FIX ",
        "CHECK"
      ],
      "course": "final-project-kit",
      "into": "kit"
    },
    {
      "name": "secret-in-vite",
      "dir": "solution",
      "files": {
        "project/.env.example": "# Only for `npm run dev` with a REAL API. Never put a secret in a VITE_ variable.\nVITE_API_URL=http://localhost:4000\nVITE_MAPS_API_KEY=paste-your-key-here\n"
      },
      "cmd": "cp -r project/. kit/starter/ && node ../evidence_check.mjs kit/starter",
      "exit": "nonzero",
      "expect": [
        "VITE_MAPS_API_KEY",
        "NOT READY"
      ],
      "course": "final-project-kit",
      "into": "kit"
    },
    {
      "name": "no-folder",
      "dir": "starter",
      "cmd": "node ../evidence_check.mjs no-such-folder",
      "exit": "nonzero",
      "expect": [
        "no package.json in no-such-folder"
      ]
    }
  ]
}
