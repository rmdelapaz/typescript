{
  "title": "Session 1 orientation: environment check and diagnostic practice",
  "lesson": "1.0",
  "tasks": 2,
  "runs": [
    {
      "name": "env-ready",
      "dir": ".",
      "course": "lesson-02-end",
      "api": true,
      "cmd": "cd shoreline && node ../check_environment.mjs {API}",
      "exit": 0,
      "expect": [
        "OK    tsc -b: no type errors",
        "OK    the dev server starts",
        "READY"
      ],
      "absent": [
        "FIX",
        "NOT READY"
      ]
    },
    {
      "name": "env-api-down",
      "dir": ".",
      "course": "lesson-02-end",
      "cmd": "cd shoreline && node ../check_environment.mjs http://localhost:4299",
      "exit": 1,
      "expect": [
        "FIX   nothing answers at http://localhost:4299",
        "NOT READY"
      ]
    },
    {
      "name": "env-no-hq",
      "dir": ".",
      "course": "lesson-02-start",
      "api": true,
      "cmd": "cd shoreline && node ../check_environment.mjs {API}",
      "exit": 1,
      "expect": [
        "FIX   no shoreline-hq here",
        "NOT READY"
      ]
    },
    {
      "name": "env-type-error",
      "dir": ".",
      "course": "lesson-02-end",
      "api": true,
      "files": {
        "shoreline/shoreline-hq/src/App.tsx": "const crewName: string = 'Shoreline Crew'\nconst tagline: string = 'Many hands, cleaner sands.'\n\nfunction App() {\n  return (\n    <main>\n      <h1>{crewName.toUppercase()} HQ</h1>\n      <p>{tagline}</p>\n    </main>\n  )\n}\n\nexport default App\n"
      },
      "cmd": "cd shoreline && node ../check_environment.mjs {API}",
      "exit": 1,
      "expect": [
        "FIX   tsc -b found type errors",
        "TS2551",
        "OK    the dev server starts",
        "NOT READY"
      ]
    },
    {
      "name": "starter-diagnostic",
      "dir": ".",
      "cmd": "node diagnostic_starter.mjs",
      "exit": 0,
      "expect": [
        "D1: 3 North Jetty",
        "D2: { name: 'Driftwood Cove', town: 'Port Marisol' }"
      ]
    },
    {
      "name": "solution-diagnostic",
      "dir": ".",
      "cmd": "node diagnostic_solution.mjs",
      "exit": 0,
      "expect": [
        "D1: 3 Driftwood Cove",
        "D2: Driftwood Cove",
        "D3: [ 'Jetty Rocks Deep Clean', 'Family Beach Morning' ]"
      ]
    }
  ]
}
